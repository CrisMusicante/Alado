{
  "name": "worshipflow",
  "version": "1.0.0",
  "description": "Worship song presentation app for local churches",
  "main": "out/main/index.js",
  "scripts": {
    "postinstall": "cd node_modules/better-sqlite3 && npx prebuild-install --runtime electron --target 40.8.0 --arch x64 || true",
    "dev": "electron-vite dev --config electron.vite.config.ts",
    "build": "electron-vite build --config electron.vite.config.ts",
    "preview": "electron-vite preview --config electron.vite.config.ts",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "lint": "eslint .",
    "test": "vitest"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.8",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "electron": "40.8.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "eslint": "^8.57.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.5.4",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "better-sqlite3": "^12.6.2",
    "cheerio": "^1.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  }
}
