{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "alado",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "assets": {
    "directory": "public",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "alado", "database_id": "TO_BE_CREATED", "migrations_dir": "migrations" }
  ]
}
